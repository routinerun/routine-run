  "components": {
    "securitySchemes": {
      "secret": {
        "type": "http",
        "scheme": "bearer",
        "description": "The connection's secret, rr_\u2026, shown in the app."
      }
    },
    "schemas": {
      "Accepted": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "format": "uuid"
          },
          "accepted": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Refused; error says why.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
